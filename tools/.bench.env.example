# Réglages locaux du banc de lecture. Copier en `tools/.bench.env`,
# qui est ignoré par git — le code PIN n'a rien à faire dans le dépôt.
#
#   cp tools/.bench.env.example tools/.bench.env

# Profil sélectionné automatiquement au démarrage. Sans lui, le banc
# s'arrête sur l'écran de choix de profil et ne mesure rien.
PROBE_PROFILE_ID=

# Code du profil ci-dessus, s'il en a un. Vide sinon.
PROBE_PROFILE_PIN=

# Film mesuré. Doit être DÉJÀ TÉLÉCHARGÉ sur la machine, sans quoi on
# mesure le réseau. Idéalement un titre avec beaucoup de mouvement.
PROBE_MEDIA_ID=
